
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Para mi niña 💖</title>
<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: Georgia, serif;
  color: #a83265;
  text-align: center;
  background: linear-gradient(135deg,#ffe2ee,#fff8fb,#ffd1e3);
  min-height: 100vh;
}

#corazones {
  position: fixed;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 5;
}

.flotante {
  position: absolute;
  bottom: -40px;
  animation: subir 6s linear forwards;
}

@keyframes subir {
  to { transform: translateY(-110vh); opacity: 0; }
}

.pantalla {
  min-height: 100vh;
  padding: 24px 12px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.tarjeta {
  width: 100%;
  max-width: 480px;
  padding: 25px 18px;
  background: #ffffffed;
  border: 2px solid white;
  border-radius: 25px;
  box-shadow: 0 8px 25px #cf6c9633;
}

h1 { font-size: clamp(28px,7vw,40px); }

p {
  line-height: 1.8;
  font-size: 16px;
}

button {
  border: 0;
  border-radius: 24px;
  padding: 13px 18px;
  margin: 5px;
  background: #df6295;
  color: white;
  font-size: 16px;
  cursor: pointer;
  touch-action: manipulation;
}

#juego { display: none; }

#mapa {
  display: grid;
  grid-template-columns: repeat(9,minmax(0,1fr));
  gap: 3px;
  padding: 5px;
  background: #f5c4d8;
  border-radius: 12px;
  margin: 18px 0;
}

.celda {
  min-width: 0;
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff8fb;
  border-radius: 5px;
  font-family: sans-serif;
  font-size: clamp(12px,4vw,21px);
}

.celda.bloque { background: #d98daf; }
.celda.rastro { background: #f5b0ce; }
.celda.casa { background: #ffdfeb; }

#mensaje {
  min-height: 55px;
  font-weight: bold;
}

.controles button {
  min-width: 54px;
  min-height: 46px;
  font-size: 20px;
}

</style>
</head>
<body>

<div id="corazones"></div>

<section id="carta" class="pantalla">
  <div class="tarjeta">
    <h1>Para mi niña 💖</h1>

    <p>
      Quería hacerte algo especial, algo que fuera solo nuestro.
      Aunque a veces estemos lejos, quiero que sepas que eres
      alguien muy importante para mí.
    </p>

    <p>
      Si pudiera elegir dónde estar ahora mismo, elegiría estar
      contigo, abrazarte y pasar horas a tu lado.
      Hasta que podamos hacerlo, quiero que recuerdes que,
      por lejos que estemos, siempre merece la pena encontrar
      el camino hacia ti. 💖
    </p>

    <p>
      He preparado un pequeño juego para nosotros.
      ¿Conseguiremos encontrarnos?
    </p>

    <button id="entrar">Vamos a encontrarnos 💖</button>
  </div>
</section>

<section id="juego" class="pantalla">
  <div class="tarjeta">
    <h1>Encuentra el camino 💖</h1>
    <p>Empiezas en tu casita. Llega hasta la mía para reunirnos.</p>

    <div id="mapa"></div>
    <p id="mensaje">¡Vamos! 💖</p>

    <div class="controles">
      <div><button data-x="0" data-y="-1">⬆️</button></div>
      <div>
        <button data-x="-1" data-y="0">⬅️</button>
        <button data-x="0" data-y="1">⬇️</button>
        <button data-x="1" data-y="0">➡️</button>
      </div>
    </div>

    <p>También puedes usar las flechas del teclado.</p>
    <button id="otra">Jugar otra vez</button>
    <button id="volver">Volver a la carta</button>
  </div>
</section>

<script>
/* Corazones flotantes */
const zonaCorazones = document.getElementById("corazones");

function crearCorazon() {
  const elemento = document.createElement("span");
  elemento.className = "flotante";
  elemento.textContent = "💖";
  elemento.style.left = Math.random() * 100 + "%";
  elemento.style.fontSize = (18 + Math.random() * 14) + "px";
  elemento.style.animationDuration = (4 + Math.random() * 3) + "s";
  zonaCorazones.appendChild(elemento);
  setTimeout(() => elemento.remove(), 7500);
}

setInterval(crearCorazon, 600);

/* Mapa: los puntos representan caminos transitables.
   # son obstáculos que debes rodear. */
const mapaBase = [
  ".........",
  ".##...##.",
  "...#.#...",
  ".#.....#.",
  "...#.#...",
  ".##...##.",
  "........."
];

const inicio = {x:0, y:3};
const destino = {x:8, y:3};

let jugador;
let rastro;
let finalizado;

const mapa = document.getElementById("mapa");
const mensaje = document.getElementById("mensaje");

function dibujarMapa() {
  mapa.replaceChildren();

  for (let y = 0; y < mapaBase.length; y++) {
    for (let x = 0; x < mapaBase[y].length; x++) {
      const celda = document.createElement("div");
      celda.className = "celda";

      if (mapaBase[y][x] === "#") {
        celda.classList.add("bloque");
      } else if (x === jugador.x && y === jugador.y) {
        celda.textContent = "TÚ";
        celda.classList.add("rastro");
      } else if (x === inicio.x && y === inicio.y) {
        celda.textContent = "🏡";
        celda.classList.add("casa");
      } else if (x === destino.x && y === destino.y) {
        celda.textContent = "🏠";
        celda.classList.add("casa");
      } else if (rastro.has(`${x},${y}`)) {
        celda.textContent = "💖";
        celda.classList.add("rastro");
      }

      mapa.appendChild(celda);
    }
  }
}

function mover(dx, dy) {
  if (finalizado) return;

  const nx = jugador.x + dx;
  const ny = jugador.y + dy;

  if (
    nx < 0 || nx >= 9 ||
    ny < 0 || ny >= 7 ||
    mapaBase[ny][nx] === "#"
  ) {
    mensaje.textContent = "Por ahí no se puede pasar. Prueba otro camino. 💖";
    return;
  }

  rastro.add(`${jugador.x},${jugador.y}`);
  jugador = {x:nx, y:ny};

  if (nx === destino.x && ny === destino.y) {
    finalizado = true;
    mensaje.textContent =
      "¡LO CONSEGUISTE! 💖 Por fin nos hemos encontrado. Recorrería todos los caminos para poder estar contigo.";
  } else {
    mensaje.textContent = "¡Muy bien! Sigue buscando el camino hasta mí. 💖";
  }

  dibujarMapa();
}

function reiniciar() {
  jugador = {...inicio};
  rastro = new Set();
  finalizado = false;
  mensaje.textContent = "¡Encuentra el camino hasta mi casita! 💖";
  dibujarMapa();
}

/* Botones del juego */
document.getElementById("entrar").addEventListener("click", () => {
  document.getElementById("carta").style.display = "none";
  document.getElementById("juego").style.display = "flex";
  reiniciar();
});

document.getElementById("otra").addEventListener("click", reiniciar);

document.getElementById("volver").addEventListener("click", () => {
  document.getElementById("juego").style.display = "none";
  document.getElementById("carta").style.display = "flex";
});

document.querySelectorAll(".controles button").forEach(boton => {
  boton.addEventListener("click", () => {
    mover(Number(boton.dataset.x), Number(boton.dataset.y));
  });
});

/* Teclado */
document.addEventListener("keydown", evento => {
  if (document.getElementById("juego").style.display === "none") return;

  const teclas = {
    ArrowUp: [0,-1],
    ArrowDown: [0,1],
    ArrowLeft: [-1,0],
    ArrowRight: [1,0]
  };

  if (teclas[evento.key]) {
    evento.preventDefault();
    mover(...teclas[evento.key]);
  }
});

reiniciar();
</script>

</body>
</html>
